{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "peppersalt",
  "owner": {
    "name": "znagadeon"
  },
  "metadata": {
    "description": "Claude Code plugin marketplace",
    "version": "0.7.0"
  },
  "plugins": [
    {
      "name": "draft",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/znagadeon/marketplace",
        "path": "plugins/draft",
        "ref": "draft@1.0.0"
      },
      "description": "프롬프트 재작성 함수 — 두서없는 대화를 실행하지 않고 하나의 프롬프트로 갱신해 보여준다"
    },
    {
      "name": "memopad",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/znagadeon/marketplace",
        "path": "plugins/memopad",
        "ref": "memopad@1.0.0"
      },
      "description": "메모패드 — 작업 중 떠오른 생각을 제로 컨텍스트로 지정 위치에 적어두고 바로 복귀"
    },
    {
      "name": "dailywatch",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/znagadeon/marketplace",
        "path": "plugins/dailywatch",
        "ref": "dailywatch@1.2.0"
      },
      "description": "데일리워치 — 어떤 일이 완료될 때까지 매일 첫 세션에 Claude가 직접 확인해 보고"
    },
    {
      "name": "fresheyes",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/znagadeon/marketplace",
        "path": "plugins/fresheyes",
        "ref": "fresheyes@0.1.0"
      },
      "description": "격리 리뷰 — 방금 한 작업을 대화 맥락에 오염되지 않은 깨끗한 서브에이전트로 리뷰"
    },
    {
      "name": "create-project",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/znagadeon/marketplace",
        "path": "plugins/create-project",
        "ref": "create-project@0.1.0"
      },
      "description": "/draft로 응축한 프롬프트를 받아 지정 위치에 프로젝트 폴더를 만들고 PROMPT.md 기록·git init·언어별 스캐폴딩까지 수행"
    }
  ]
}
